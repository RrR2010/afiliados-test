# TomeOferta: inventory only. This file does not configure n8n automatically.
# Prefer the n8n Credentials UI for sensitive values.
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
SQLITE_PATH=./data/tomeoferta.sqlite3
PRICE_CURRENCY=BRL

# n8n integration (only if using its API or local webhook)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SHARED_SECRET=
# Runtime backup secret (configured where n8n runs; never commit the value)
N8N_ENCRYPTION_KEY=

# Mercado Livre OAuth
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_PKCE=false
ML_SITE_ID=MLB
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# Meta Cloud API
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_SENDER_NUMBER=
# International numeric format, e.g. 55DDDNXXXXXXXX; no plus sign
WHATSAPP_OPERATOR_NUMBER=

# Future platforms: leave empty until officially authorized
AMAZON_ASSOCIATE_TAG=
AMAZON_CREATORS_CREDENTIAL_ID=
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=

# Optional LLM (off by default)
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=

# Initial guardrails
DISCOVERY_MAX_PRODUCTS=100
DISCOVERY_DELAY_SECONDS=1
SHORTLIST_SIZE=3
MIN_PRICE_HISTORY_DAYS=14
MIN_HISTORY_OBSERVATIONS=5
MIN_SCORE_TO_REVIEW=60
