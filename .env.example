# Exemplo de configuracao do TomeOferta. Copiar para .env e manter fora do Git.
# O n8n NAO carrega automaticamente este arquivo. Preferir Credenciais do n8n.
# As chaves externas de APIs sao mantidas no formato exigido pelos provedores.

# Aplicacao e banco de dados
AMBIENTE_EXECUCAO=desenvolvimento
FUSO_HORARIO=America/Sao_Paulo
CAMINHO_SQLITE=./dados/tomeoferta.sqlite3
MOEDA_PADRAO=BRL

# n8n local (somente se um script/integracao precisar usar a API)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_SHARED_SECRET=
# Usado pelo ambiente de execucao do n8n; guardar tambem em backup seguro
N8N_ENCRYPTION_KEY=

# Mercado Livre: nomes preservados para compatibilidade com o script de exploracao
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_PKCE=false
ML_SITE_ID=MLB
# Os tokens reais devem ficar em armazenamento local protegido/Credenciais do n8n
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# Meta: WhatsApp Cloud API
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_NUMERO_REMETENTE=
# Telefone do operador: somente digitos com DDI e DDD, sem o sinal +
WHATSAPP_NUMERO_OPERADOR=

# Proximas integracoes: deixar vazias ate obter acesso autorizado
AMAZON_TAG_ASSOCIADO=
AMAZON_ID_CREDENCIAL_CRIADOR=
SHOPEE_ID_APLICATIVO_AFILIADO=
SHOPEE_SEGREDO_AFILIADO=
AWIN_ID_PUBLICADOR=
AWIN_TOKEN_API=

# Uso opcional de IA (desativado inicialmente)
IA_HABILITADA=false
IA_PROVEDOR=
IA_CHAVE_API=

# Limites iniciais ajustaveis (nao sao metas validadas)
LIMITE_PRODUTOS_PESQUISA=100
INTERVALO_PESQUISA_SEGUNDOS=1
TAMANHO_SELECAO=3
MINIMO_DIAS_HISTORICO=14
MINIMO_OBSERVACOES_HISTORICO=5
PONTUACAO_MINIMA_REVISAO=60
